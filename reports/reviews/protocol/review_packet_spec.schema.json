{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KelvinYangBK67/sktlm/review_packet_spec.schema.json",
  "additionalProperties": false,
  "properties": {
    "files": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "packet_path": {"minLength": 1, "type": "string"},
          "path": {"minLength": 1, "type": "string"},
          "role": {
            "enum": [
              "method_spec", "experimental_design", "decisions", "provenance",
              "six_representation_summary", "quantitative_tables",
              "qualitative_materials", "limitations", "reviewer_prompt",
              "reviewer_method"
            ]
          }
        },
        "required": ["role", "path", "packet_path"],
        "type": "object"
      },
      "minItems": 10,
      "type": "array"
    },
    "milestone_id": {"minLength": 1, "type": "string"},
    "schema_version": {"const": "sktlm-review-packet-spec/v1"},
    "scientific_commit": {"pattern": "^[0-9a-f]{40}$", "type": "string"}
  },
  "required": ["schema_version", "milestone_id", "scientific_commit", "files"],
  "title": "sktlm frozen review packet specification",
  "type": "object"
}